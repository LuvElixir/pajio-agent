[Unit]
Description=Pajio internal VM network boundaries
# Ownership checks read VM configuration through pmxcfs; without it the unit
# fails closed and pve-guests (which requires this unit) starts no guests.
After=local-fs.target pve-cluster.service
Requires=pve-cluster.service
Before=pve-guests.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pajio-apply-lab-network
ExecReload=/usr/local/sbin/pajio-apply-lab-network
RemainAfterExit=yes
# Stopping this unit deliberately leaves filtering in place. To remove the
# lab, stop all its VMs before explicitly removing its named nft tables.

[Install]
WantedBy=multi-user.target
